# ============================================================
# CMS Portfolio — all secrets and server config in one place.
# Used by backend-express (and the legacy PHP backend).
# Copy this file to .env and fill in the values.
# ============================================================

APP_ENV=local
APP_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:5173

# --- Local (XAMPP) — uncomment to switch back ---
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=cms-portfolio
# DB_USER=root
# DB_PASS=

# --- Remote (Hostinger) ---
DB_HOST=your-db-host
DB_PORT=3306
DB_NAME=your-db-name
DB_USER=your-db-user
DB_PASS=

# REQUIRED: at least 32 random characters. The server refuses to start without it.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_TTL=86400

# Elastic Email SMTP (isi nanti saat sudah punya akun Elastic Email)
SMTP_HOST=smtp.elasticemail.com
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=Portfolio Website
CONTACT_RECIPIENT=info@example.com

UPLOAD_MAX_BYTES=10485760

# --- Express server ---
PORT=8000

# How many reverse proxies are in front of the API (nginx, hosting panel, Cloudflare).
# 0 = none (local development). On a server behind a proxy use 1, otherwise
# every visitor looks like the same IP and the rate limits block everyone at once.
TRUST_PROXY=0

# Rate limits per IP address
LOGIN_RATE_LIMIT=10      # failed logins per 15 minutes
CONTACT_RATE_LIMIT=5     # contact messages per hour

# Set to "off" to hide the API documentation at /api/docs
API_DOCS=on
