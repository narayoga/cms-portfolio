{
  // Static SPA deploy: Cloudflare Workers only serves the built files in dist/.
  // Having this file stops `wrangler deploy` from trying to auto-configure Vite
  // (that auto-setup needs Vite 6+, and this project uses Vite 5).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cms-portfolio",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // React Router: unknown paths like /admin/products fall back to index.html
    "not_found_handling": "single-page-application"
  },
  // Production address. Cloudflare creates the DNS record and the HTTPS certificate (zone actcomp.online).
  // The API (cms-api.actcomp.online) only allows this origin via FRONTEND_ORIGIN in /opt/cms-portfolio/.env.prod.
  "routes": [{ "pattern": "cms.actcomp.online", "custom_domain": true }],
  // The old cms-portfolio.oganara.workers.dev address is off: the API's CORS no longer allows it.
  "workers_dev": false,
  "preview_urls": false
}
