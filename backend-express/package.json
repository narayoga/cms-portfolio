{
  "name": "portfolio-cms-backend-express",
  "version": "1.0.0",
  "description": "Portfolio CMS backend — Express + TypeScript REST API",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
