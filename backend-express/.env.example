APP_ENV=production
APP_URL=https://api.example.com
FRONTEND_ORIGIN=https://example.com

DB_HOST=localhost
DB_PORT=3306
DB_NAME=portfolio_cms
DB_USER=root
DB_PASS=

JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=86400

# Elastic Email SMTP
SMTP_HOST=smtp.elasticemail.com
SMTP_PORT=2525
SMTP_USER=your-elastic-username
SMTP_PASS=your-elastic-api-key
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=Portfolio Website
CONTACT_RECIPIENT=info@example.com

UPLOAD_MAX_BYTES=10485760

# Express server
PORT=8000
